#!/bin/bash
# Open WindowAlign once so the first-launch Accessibility window can appear.
# Installer scripts run as root; start the app in the console user's GUI session.

CONSOLE_USER="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -z "${CONSOLE_USER}" || "${CONSOLE_USER}" == "root" || "${CONSOLE_USER}" == "loginwindow" ]]; then
  exit 0
fi
if [[ ! -d /Applications/WindowAlign.app ]]; then
  exit 0
fi

USER_ID="$(id -u "${CONSOLE_USER}" 2>/dev/null || true)"
if [[ -z "${USER_ID}" ]]; then
  exit 0
fi

launchctl asuser "${USER_ID}" /usr/bin/open /Applications/WindowAlign.app || true
exit 0
